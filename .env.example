# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Токен: GitHub -> Settings -> Developer settings -> Personal access tokens (classic),
# scopes: repo, workflow.
GH_TOKEN=ghp_ВАШ_ТОКЕН
GH_OWNER=avovka0-spec
GH_REPO=price-radar
# chat_id получателя статусов/отчётов (владелец бота)
TELEGRAM_CHAT_ID=1782021699

# Алерты об изменении цен в Telegram (локальный агент check-prices-local.mjs).
# Можно отдельный бот (например @Price_radar_monitor_bot) или тот же. Токен только локально!
TELEGRAM_PRICE_BOT_TOKEN=
TELEGRAM_PRICE_CHAT_ID=1782021699
